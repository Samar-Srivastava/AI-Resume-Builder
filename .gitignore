#################################
# 1. DEPENDENCIES & ARTIFACTS
#################################
# Node.js dependencies
/frontend/node_modules
/backend/node_modules

# Frontend (Vite/React) Build Output
/frontend/dist
/frontend/dist-ssr
/frontend/.vite/

# Backend (Strapi) Build Output
/backend/build
/backend/dist
/backend/.cache

# Temporary/Cache Files
/backend/.tmp
/backend/exports
/backend/.strapi
/backend/pids
/backend/lcov.info
/backend/coverage


#################################
# 2. LOGS & DATABASES
#################################
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Database files (PostgreSQL/SQLite)
/backend/database/data.db* # Matches common Strapi SQLite data files
/backend/*.sql
/backend/*.sqlite
/backend/*.sqlite3


#################################
# 3. ENVIRONMENT & CONFIGURATION
#################################
# Environment variables (Crucial for Vercel/Render security)
/frontend/.env
/frontend/.env.local
/backend/.env
/backend/.env.local

# Strapi-specific configuration files (often auto-generated)
/backend/.strapi-updater.json
/backend/.strapi-cloud.json
/backend/license.txt

# Media Uploads (Should be stored externally in production)
/backend/public/uploads/*
!/backend/public/uploads/.gitkeep


#################################
# 4. OS & IDE
#################################
.DS_Store
Icon?
Thumbs.db
ehthumbs.db
.idea
.vscode/
# Ignore common swap/temp files
*.swp
*.swo
*.suo